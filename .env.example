APP_NAME="Audax Proyectos"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL en Docker, solo en 127.0.0.1 (docs/RUNBOOK-DESPLIEGUE.md, paso 6). Valores ficticios.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=15432
DB_DATABASE=audax_projects
DB_USERNAME=audax_app
DB_PASSWORD=cambiar-esto

# Sesiones en base de datos: permiten la pantalla de sesiones activas (SPEC §15).
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
# Por encima del timeout del job más largo de Horizon (exportación de datos personales, 600 s).
REDIS_QUEUE_RETRY_AFTER=660
CACHE_STORE=redis

# Valkey propio en Docker (NUNCA el Redis compartido del 6379). Valores ficticios.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_PASSWORD=cambiar-esto
REDIS_PREFIX=audaxp_
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-responder@audaxstudio.com"
MAIL_FROM_NAME="${APP_NAME}"
# En el servidor: relé SMTP de Google Workspace (solo desde la IP del servidor, sin credenciales)
# MAIL_MAILER=smtp MAIL_SCHEME=smtp MAIL_HOST=smtp-relay.gmail.com MAIL_PORT=587 MAIL_EHLO_DOMAIN=projects.audaxstudio.com

VITE_APP_NAME="${APP_NAME}"

# Tiempo real (Fase 6, D-068). Con BROADCAST_CONNECTION=reverb se activa; con log, la interfaz
# usa consultas periódicas. Reverb escucha solo en 127.0.0.1:18080 (audax-reverb.service) y nginx
# le pasa /app/ desde el 443. El navegador recibe host, puerto y clave en la prop `realtime`.
REVERB_APP_ID=audax-projects
REVERB_APP_KEY=cambiar-esta-clave-publica
REVERB_APP_SECRET=cambiar-este-secreto
REVERB_HOST=127.0.0.1
REVERB_PORT=18080
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=18080
REVERB_SCALING_ENABLED=false
REVERB_CLIENT_HOST=projects.audaxstudio.com
REVERB_CLIENT_PORT=443
REVERB_CLIENT_SCHEME=https
# Hosts (sin esquema ni puerto, separados por comas) que pueden abrir el WebSocket. Si se deja
# vacío, se usa el host de APP_URL.
REVERB_ALLOWED_ORIGINS=projects.audaxstudio.com

# Transcripción de audios del chat (Fase 6, D-070): whisper.cpp en 127.0.0.1:18091 (audax-whisper)
# y su propio worker de un proceso (audax-transcriber.service). En local: TRANSCRIPTION_DRIVER=fake.
TRANSCRIPTION_DRIVER=whisper
TRANSCRIPTION_QUEUE_CONNECTION=redis-transcriptions
TRANSCRIPTION_LANGUAGE=es
# Dictados de la weekly (D-243): gemini (en segundos, como WeeklySync) o whisper (en el servidor).
DICTATION_TRANSCRIPTION_DRIVER=gemini
WHISPER_URL=http://127.0.0.1:18091
WHISPER_MODEL=small
WHISPER_TIMEOUT=2340

# PDF de los informes (Fase 9, D-140): Gotenberg en Docker (contenedor audax-gotenberg, solo en
# 127.0.0.1). En local sin Docker: REPORTS_PDF_DRIVER=html (descarga el HTML en vez del PDF).
REPORTS_PDF_DRIVER=gotenberg
GOTENBERG_URL=http://127.0.0.1:18092
GOTENBERG_TIMEOUT=65

# Web Push (Fase 6, D-072): avisos del navegador (menciones y mensajes directos). Las claves se
# generan en el servidor con `php artisan push:vapid-keys` (las imprime; no se guardan en Git).
# Con estos valores de ejemplo, que no son claves válidas, el canal queda desactivado sin errores.
VAPID_PUBLIC_KEY=cambiar-esta-clave-publica-vapid
VAPID_PRIVATE_KEY=cambiar-esta-clave-privada-vapid
VAPID_SUBJECT="mailto:no-responder@audaxstudio.com"

# Google Sheets (Fase 9, D-142): cliente OAuth 2.0 «Interno» del proyecto `audax-proyectos` de
# Google Cloud. El ID y el secreto los pone el propietario en el .env del servidor (nunca en Git).
# Vacíos, la exportación a Google Sheets no se ofrece. La URI de redirección debe ser exactamente
# la autorizada en Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://projects.audaxstudio.com/integraciones/google/callback
GOOGLE_HOSTED_DOMAIN=audaxstudio.com

# IA externa de la Weekly (Fase 10, D-146): solo texto a Google Gemini (clave de pago de AI Studio)
# y la locución con Google Cloud TTS. Las claves las pone el propietario en el .env del servidor
# (nunca en Git). GEMINI_MODEL se cambia sin desplegar cuando Google retira un modelo (F-174).
# En local sin claves: GEMINI_DRIVER=fake y GOOGLE_TTS_DRIVER=fake.
GEMINI_DRIVER=gemini
GEMINI_API_KEY=cambiar-esta-clave-de-gemini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=120
# Límites por persona y día (D-222); 0 = sin límite.
AI_DAILY_LIMIT_ASSISTANT=60
AI_DAILY_LIMIT_SUMMARIES=30
AI_DAILY_LIMIT_SUGGESTED_TASKS=10
GOOGLE_TTS_DRIVER=google
GOOGLE_TTS_API_KEY=cambiar-esta-clave-de-tts
GOOGLE_TTS_VOICE=es-ES-Journey-F
# Acceso con Google (D-165): el mismo cliente OAuth con una segunda URI de redirección, que también
# hay que autorizar en Google Cloud. Dominios de Workspace que pueden entrar, separados por comas.
# El interruptor está en /admin/ajustes (activo por defecto si hay credenciales).
GOOGLE_LOGIN_REDIRECT_URI=https://projects.audaxstudio.com/login/google/callback
GOOGLE_LOGIN_DOMAINS=audaxstudio.com
# Facturación (Fase 12, F1; D-384): lectura de Holded por la API v2 (solo lectura). La clave la pone
# el propietario en el .env del servidor (nunca en Git): en Holded, Configuración → Desarrolladores →
# Nueva clave de API con permiso de solo lectura en Contactos, Proyectos y Ventas (facturas,
# rectificativas, cobros y PDF). En local sin clave: HOLDED_DRIVER=fake (datos de ejemplo).
HOLDED_DRIVER=holded
HOLDED_API_KEY=cambiar-esta-clave-de-holded
# Peticiones por minuto que nunca se superan (el plan de Holded permite de 60 a 600).
HOLDED_PER_MINUTE=60
