[Unit]
Description=Audax Proyectos - scheduler
After=network-online.target docker.service
Wants=network-online.target
PartOf=audax-projects.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=audaxprojects
Group=psacln
Slice=system-audax.slice
WorkingDirectory=/var/www/vhosts/projects.audaxstudio.com/app/current
Environment=XDEBUG_MODE=off
ExecStartPre=/usr/local/lib/audax/esperar-puerto.sh 16379 60
ExecStartPre=/usr/local/lib/audax/esperar-puerto.sh 15432 60
ExecStart=/opt/plesk/php/8.4/bin/php artisan schedule:work
TimeoutStartSec=150
KillSignal=SIGTERM
TimeoutStopSec=60
Restart=always
RestartSec=15
MemoryLimit=256M
CPUQuota=50%
TasksMax=64
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
OOMScoreAdjust=1000
LimitNOFILE=4096
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectControlGroups=yes
SyslogIdentifier=audax-scheduler

[Install]
WantedBy=audax-projects.target
